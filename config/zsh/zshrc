# Fragmentos opcionais instalados pelos perfis devem carregar antes do prompt.
for fragment in "${XDG_CONFIG_HOME:-$HOME/.config}"/zsh/pre.d/*.zsh(N); do
  source "$fragment"
done
unset fragment

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
ZLE_RPROMPT_INDENT=0
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

typeset -U path PATH
path=("$HOME/.local/bin" $path)

ZSH_HIGHLIGHT_STYLES[path]=none
ZSH_HIGHLIGHT_STYLES[path_prefix]=none
ZSH_HIGHLIGHT_STYLES[precommand]='fg=green'

[[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"

# Fragmentos opcionais instalados pelos perfis carregam por último.
for fragment in "${XDG_CONFIG_HOME:-$HOME/.config}"/zsh/post.d/*.zsh(N); do
  source "$fragment"
done
unset fragment
